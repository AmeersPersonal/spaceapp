# Copy to .env.local to override. Where the dev server forwards /api, /auth and /tiles.
# Default is the local Worker started with `npm run dev` in backend/cloudefare.
VITE_API_TARGET=http://localhost:8787

# The deployed API also works for public data (events, briefings), but sign-in
# only works against a local Worker, because Auth0 returns to the API's own host.
# VITE_API_TARGET=https://earth-replay-api.jc-cloudflare-a56b8c1d.workers.dev
