# Copy to .dev.vars for `wrangler dev`. Never commit .dev.vars.
# Earthdata Login user token (https://urs.earthdata.nasa.gov -> Generate Token). Optional for search.
EARTHDATA_TOKEN=
# When set, POST /api/ingest requires `Authorization: Bearer <INGEST_API_KEY>`.
INGEST_API_KEY=
# Shared secret sent to the Python processor as a bearer token.
PROCESSOR_TOKEN=

# Google Maps Platform key with the Geocoding API enabled (optional; /api/geocode returns 503 without it).
GOOGLE_MAPS_API_KEY=
