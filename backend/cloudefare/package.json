{
  "name": "earth-replay-cloudflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build:frontend": "npm --prefix ../../Frontend run build",
    "deploy": "npm run build:frontend && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply earth-replay --local",
    "db:migrate:remote": "wrangler d1 migrations apply earth-replay --remote",
    "test": "vitest run"
  },
  "dependencies": {
    "@auth0/auth0-hono": "^1.2.6",
    "@cloudflare/containers": "^0.3.7",
    "hono": "^4.13.18"
  },
  "devDependencies": {
    "@auth0/auth0-server-js": "^1.17.0",
    "@cloudflare/vitest-plugin": "^1.8.2",
    "vitest": "~4.1.0",
    "wrangler": "^4.162.0"
  }
}
